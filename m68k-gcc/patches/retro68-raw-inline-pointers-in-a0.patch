         return gen_rtx_REG (mode, cum.arg_regs[0]);
     }
 
+#ifdef M68K_RAW_INLINE_POINTERS_IN_A0
+  /* Palm OS system traps, declared as raw_inline functions, return
+     pointers in %a0 (and other values in %d0).  */
