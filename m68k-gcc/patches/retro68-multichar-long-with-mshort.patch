-  size_t max_chars = CPP_OPTION (pfile, int_precision) / width;
+  /* A multi-character constant that does not fit in an int has type long
+     if long is wider (int is 16 bits with -mshort on m68k, where Palm OS
+     code uses four-character constants such as 'appl' throughout).  */
+  size_t max_chars = MAX (CPP_OPTION (pfile, int_precision),
+			  CPP_OPTION (pfile, long_precision)) / width;
   size_t mask = width_to_mask (width);
   size_t i;
   cppchar_t result, c;
@@ -2936,7 +2940,7 @@ narrow_str_to_charconst (cpp_reader *pfile, cpp_string str,
       if (type != CPP_UTF8CHAR)
 	cpp_error (pfile, CPP_DL_WARNING,
 		   "multi-character literal with %ld characters exceeds "
-		   "%<int%> size of %ld bytes", (long) i, (long) max_chars);
+		   "%<long%> size of %ld bytes", (long) i, (long) max_chars);
       else if (src_chars > 2)
 	cpp_error (pfile, CPP_DL_ERROR,
 		   "multi-character literal cannot have an encoding prefix");
@@ -2961,7 +2965,11 @@ narrow_str_to_charconst (cpp_reader *pfile, cpp_string str,
      For single-character constants, the value is WIDTH bits wide.
      For multi-character constants, the value is INT_PRECISION bits wide.  */
   if (i > 1)
-    width = CPP_OPTION (pfile, int_precision);
+    {
+      width = CPP_OPTION (pfile, int_precision);
+      if (i * CPP_OPTION (pfile, char_precision) > width)
+	width = CPP_OPTION (pfile, long_precision);
+    }
   if (width < BITS_PER_CPPCHAR_T)
     {
       mask = ((cppchar_t) 1 << width) - 1;
